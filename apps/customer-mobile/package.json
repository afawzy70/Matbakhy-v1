{
  "name": "@matbakhy/customer-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Matbakhy customer Android and iOS app (React Native + Expo)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --ci",
    "bundle:native": "expo export --platform android --platform ios --output-dir dist --no-minify"
  },
  "dependencies": {
    "expo": "57.0.27",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}

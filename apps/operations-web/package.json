{
  "name": "@matbakhy/operations-web",
  "private": true,
  "version": "0.1.0",
  "description": "Matbakhy operations web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:staging": "playwright test -c playwright.staging.config.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@matbakhy/api-client": "workspace:*",
    "@matbakhy/design-tokens": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}

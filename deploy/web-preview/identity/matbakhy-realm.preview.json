{
  "realm": "matbakhy",
  "displayName": "Matbakhy (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "en"
  ],
  "defaultLocale": "ar",
  "accessTokenLifespan": 300,
  "attributes": {
    "matbakhy.note": "Local reference realm template. scripts/dev.sh fills the placeholders from infra/.env into infra/.generated (ignored by Git).",
    "acr.loa.map": "{\"mfa\": \"2\"}"
  },
  "clients": [
    {
      "clientId": "matbakhy-web",
      "name": "Matbakhy web (server-side OIDC client)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://api.${PREVIEW_DOMAIN}/login/oauth2/code/keycloak"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.${PREVIEW_DOMAIN}/*##https://ops.${PREVIEW_DOMAIN}/*",
        "acr.loa.map": "{\"mfa\": \"2\"}"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "matbakhy-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matbakhy-admin",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "description": "Service account used only by the API for the audited MFA reset and to end sessions (never public)"
    }
  ],
  "users": [
    {
      "id": "7d3f0a52-1c0e-4b8e-9a3e-000000000c01",
      "username": "preview-customer-1",
      "email": "preview-customer-1@preview.matbakhy.invalid",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Preview Customer 1",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "${PREVIEW_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "7d3f0a52-1c0e-4b8e-9a3e-000000000c02",
      "username": "preview-customer-2",
      "email": "preview-customer-2@preview.matbakhy.invalid",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Preview Customer 2",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "${PREVIEW_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "7d3f0a52-1c0e-4b8e-9a3e-0000000000a1",
      "username": "preview-cook-1",
      "email": "preview-cook-1@preview.matbakhy.invalid",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Preview Cook 1",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "${PREVIEW_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "7d3f0a52-1c0e-4b8e-9a3e-0000000000f1",
      "username": "preview-ops-1",
      "email": "preview-ops-1@preview.matbakhy.invalid",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Preview Ops 1",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "${PREVIEW_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "7d3f0a52-1c0e-4b8e-9a3e-0000000000f2",
      "username": "preview-ops-2",
      "email": "preview-ops-2@preview.matbakhy.invalid",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Preview Ops 2",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "${PREVIEW_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-matbakhy-admin",
      "serviceAccountClientId": "matbakhy-admin",
      "enabled": true,
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    }
  ],
  "browserFlow": "matbakhy browser",
  "authenticationFlows": [
    {
      "alias": "matbakhy browser",
      "description": "Browser flow with LoA step-up: level 1 password; level 2 adds OTP when the client asks for acr mfa/2",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "matbakhy browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "matbakhy browser forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "flowAlias": "matbakhy level 1",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "matbakhy level 2",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "matbakhy level 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "matbakhy-loa-1",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "matbakhy-pwd-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "matbakhy level 2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "matbakhy-loa-2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "matbakhy-otp-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "matbakhy-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000",
        "loa-store-in-user-session": "true"
      }
    },
    {
      "alias": "matbakhy-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0",
        "loa-store-in-user-session": "true"
      }
    },
    {
      "alias": "matbakhy-pwd-amr",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "matbakhy-otp-amr",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "0"
      }
    }
  ],
  "roles": {
    "realm": []
  }
}

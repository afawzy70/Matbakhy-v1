# Matbakhy web preview: copy to /srv/matbakhy-preview/.env on the server (mode 600, never committed).
# Every value below is a placeholder. Generate secrets on the server with deploy.sh init-secrets.

# Immutable images built and tested at one commit (deploy/web-preview/README.md, "Images").
RELEASE_COMMIT=0000000000000000000000000000000000000000
API_IMAGE=ghcr.io/OWNER/matbakhy-api@sha256:REPLACE_WITH_DIGEST
FRONT_IMAGE=ghcr.io/OWNER/matbakhy-preview-front@sha256:REPLACE_WITH_DIGEST

# Public names: app., ops., api., id. and media. must point at the server (owner input).
PREVIEW_DOMAIN=preview.example.invalid
ACME_EMAIL=owner@example.invalid
# Comma-free, space-separated list of the testers' public addresses or ranges (owner input).
ALLOWED_CLIENT_IPS=203.0.113.10/32

# Secrets (replace all; deploy.sh refuses the REPLACE_ME marker).
POSTGRES_PASSWORD=REPLACE_ME
KEYCLOAK_DB_PASSWORD=REPLACE_ME
# API runtime database role (least privilege; the owner password above is used only for migrations).
APP_DB_PASSWORD=REPLACE_ME
KEYCLOAK_ADMIN_USER=preview-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME
OIDC_WEB_CLIENT_SECRET=REPLACE_ME
PREVIEW_USER_PASSWORD=REPLACE_ME
PHONE_CODE_PEPPER=REPLACE_ME
HANDOVER_HASH_KEY=REPLACE_ME
ACTIVITY_HASH_KEY=REPLACE_ME
HANDOVER_ENCRYPTION_KEY=REPLACE_ME
PUSH_TOKEN_HASH_KEY=REPLACE_ME
PUSH_TOKEN_ENCRYPTION_KEY=REPLACE_ME
STORAGE_ACCESS_KEY=REPLACE_ME
STORAGE_SECRET_KEY=REPLACE_ME
# Grafana (loopback only, reached through an SSH tunnel).
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# Optional: Keycloak subject that becomes the first staff administrator (preview-ops-1 in the preview realm).
STAFF_BOOTSTRAP_SUBJECT=7d3f0a52-1c0e-4b8e-9a3e-0000000000f1

# Server paths.
GENERATED_DIR=/srv/matbakhy-preview/generated
BACKUP_DIR=/srv/matbakhy-backups

# Observability retention (MB-039). REHEARSAL values, not approved retention periods: O06 decides them.
LOG_RETENTION=168h
METRICS_RETENTION=15d

# Reverse proxy for the Matbakhy web preview. Every host is HTTPS (automatic certificates). Access is deny-by-default and
# has two classes (owner decision 2026-10-14):
#   customer class  CUSTOMER_ALLOWED_IPS  app., the customer API, id. (the matbakhy realm) and media.
#   staff class     STAFF_ALLOWED_IPS     ops. and the kitchen and staff APIs (/api/v1/ops, /api/v1/cook)
# Both default to ALLOWED_CLIENT_IPS, so nothing is public until the owner sets CUSTOMER_ALLOWED_IPS="0.0.0.0/0 ::/0".
# Privileged operations never follow the customer class. A network allow-list keeps sign-in redirects and API calls
# working, unlike a password prompt in front of the identity provider. Access logs are off; container logs are size-bounded.
# Caddy orders directives by type, not by position (an unconditional "respond" runs before "reverse_proxy"), so every site
# wraps its directives in route { }, which keeps the written order. scripts/test_proxy_access.py runs this file.
{
	email {$ACME_EMAIL}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

(web_csp) {
	# SEC-004: Report-Only first, so it cannot break sign-in, checkout, staff or image flows while it is validated in the
	# browser E2E; promote to Content-Security-Policy once those flows run clean under it (docs/security/csp-rollout.md).
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://media.{$PREVIEW_DOMAIN}; font-src 'self'; connect-src 'self' https://api.{$PREVIEW_DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

(customer_access) {
	@customer_outsider not remote_ip {$CUSTOMER_ALLOWED_IPS}
	respond @customer_outsider "Not available" 403
}

(staff_access) {
	@staff_outsider not remote_ip {$STAFF_ALLOWED_IPS}
	respond @staff_outsider "Not available" 403
}

app.{$PREVIEW_DOMAIN} {
	route {
		import headers
		import customer_access
		import web_csp
		header X-Frame-Options DENY
		encode zstd gzip
		root * /srv/customer-web
		try_files {path} /index.html
		file_server
	}
}

ops.{$PREVIEW_DOMAIN} {
	route {
		import headers
		import staff_access
		import web_csp
		header X-Frame-Options DENY
		encode zstd gzip
		root * /srv/operations-web
		try_files {path} /index.html
		file_server
	}
}

api.{$PREVIEW_DOMAIN} {
	route {
		import headers
		# Kitchen and staff APIs answer the staff class only, whatever the customer class allows.
		@staff_api_outsider {
			path /api/v1/ops /api/v1/ops/* /api/v1/cook /api/v1/cook/*
			not remote_ip {$STAFF_ALLOWED_IPS}
		}
		respond @staff_api_outsider "Not available" 403
		import customer_access
		# Only the API and the OIDC login endpoints are exposed; actuator stays internal.
		@public path /api/* /oauth2/* /login/oauth2/* /logout
		reverse_proxy @public api:8080
		respond 404
	}
}

id.{$PREVIEW_DOMAIN} {
	route {
		import headers
		import customer_access
		# The admin console and the master realm are never served on the customer host: they live on kc-admin.* below.
		@admin path /admin /admin/* /realms/master /realms/master/*
		respond @admin 404
		reverse_proxy identity:8080
	}
}

# Keycloak admin console for the Preview (owner approval 2026-10-19; Preview only, never production). Deliberately NOT IP-restricted,
# so the owner can sign in from a phone on mobile data; the protection is Keycloak's own: every master-realm sign-in needs the password
# AND a one-time password (browser flow "matbakhy master browser"), the password grant is off for all master clients, failed sign-ins are
# throttled, and Admin REST calls need a bearer token (401 without one). Only what the console needs is forwarded: /admin (console and
# Admin REST), /realms/master (its sign-in) and the static assets. The matbakhy realm, the health and metrics endpoints (management port
# 9000, never published) and everything else answer 404 here. The whole host answers 404 until admin-console.sh has hardened and verified
# Keycloak and created /srv/flags/admin-console-public (fail closed; deleting that file closes the host again at once).
kc-admin.{$PREVIEW_DOMAIN} {
	route {
		import headers
		@closed {
			not {
				file {
					root /srv/flags
					try_files /admin-console-public
				}
			}
		}
		respond @closed "Not available" 404
		redir / /admin/master/console/ 302
		request_body {
			max_size 10MB
		}
		@console path /admin /admin/* /realms/master /realms/master/* /resources/* /js/*
		reverse_proxy @console identity:8080
		respond 404
	}
}

media.{$PREVIEW_DOMAIN} {
	route {
		import headers
		import customer_access
		reverse_proxy storage:8333
	}
}

{
  "realm": "matbakhy",
  "displayName": "Matbakhy (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "en"
  ],
  "defaultLocale": "ar",
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "mail",
    "port": "1025",
    "from": "no-reply@matbakhy.test",
    "fromDisplayName": "Matbakhy local"
  },
  "attributes": {
    "matbakhy.note": "Local reference realm template. scripts/dev.sh fills the placeholders from infra/.env into infra/.generated (ignored by Git)."
  },
  "clients": [
    {
      "clientId": "matbakhy-web",
      "name": "Matbakhy web (server-side OIDC client)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:${API_PORT}/login/oauth2/code/keycloak"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "matbakhy-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matbakhy-mobile",
      "name": "Matbakhy customer app (public client, PKCE)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "matbakhy-dev://auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "matbakhy-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-0000000000a1",
      "username": "customer-a",
      "email": "customer-a@matbakhy.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Customer",
      "lastName": "SyntheticA",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-0000000000b1",
      "username": "customer-b",
      "email": "customer-b@matbakhy.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Customer",
      "lastName": "SyntheticB",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-0000000000c1",
      "username": "cook-a",
      "email": "cook-a@matbakhy.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Cook",
      "lastName": "SyntheticA",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-4000-8000-0000000000d2",
      "username": "ops-a",
      "email": "ops-a@matbakhy.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ops",
      "lastName": "SyntheticA",
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "browserFlow": "matbakhy browser",
  "authenticationFlows": [
    {
      "alias": "matbakhy browser",
      "description": "Browser flow; staff accounts (realm role matbakhy-staff) must also pass OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "matbakhy browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "matbakhy browser forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "matbakhy-pwd-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "matbakhy staff mfa",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "matbakhy staff mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "matbakhy-staff-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "matbakhy-otp-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "matbakhy-staff-role",
      "config": {
        "condUserRole": "matbakhy-staff",
        "negate": "false"
      }
    },
    {
      "alias": "matbakhy-pwd-amr",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "matbakhy-otp-amr",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "0"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "matbakhy-staff",
        "description": "Accounts holding staff grants; the identity provider requires OTP for every login (BR-007)"
      }
    ]
  }
}

# Local development settings for infra/compose.yaml. Copy to infra/.env (scripts/dev.sh does this and
# generates random local passwords). Placeholders only; never commit infra/.env or real credentials.
MATBAKHY_ENV_MARKER=local
COMPOSE_PROJECT_NAME=matbakhy
POSTGRES_DB=matbakhy
POSTGRES_USER=matbakhy
POSTGRES_PASSWORD=change-me-generated-locally
KEYCLOAK_ADMIN_USER=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-generated-locally
POSTGRES_PORT=5432
IDENTITY_PORT=8180
OBJECT_STORAGE_PORT=9090
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025
API_PORT=8080
